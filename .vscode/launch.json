{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Windows",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/install/bin/runes.exe",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/install/bin",
            "externalConsole": false,
            "preLaunchTask": "Compile",
        },
            {
            "name": "Debug Linux",
            "request": "launch",
            "type": "cppdbg",
            "program": "${workspaceFolder}/build/bin/runes",
            "miDebuggerPath": "/usr/bin/gdb",
            "MIMode": "gdb",
            "args": [],
            "stopAtEntry": false,
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "preLaunchTask": "Compile",
        },
    ]
}
