{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "type": "cppdbg",
            "request": "launch",
            "windows": {
                "program": "${workspaceFolder}/install/bin/runes.exe",
            },
            "linux": {
                "program": "${workspaceRoot}/build/bin/runes"
            },
            "args": [],
            "stopAtEntry": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "preLaunchTask": "Compile",
        }
    ]
}
