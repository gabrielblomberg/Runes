{
    "version": "2.0.0",
    "tasks": [
		{
            "label": "Setup",
            "detail": "Setup a new development environment.",
            "type": "shell",
            "windows": {
                "command": "call scripts/windows/setup.bat"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Compile",
			"detail": "Compile the most recently configure build",
			"type": "shell",
			"windows": {
				"command": "call scripts/windows/compile.bat ${input:build_type}",
				"problemMatcher": "$msCompile"
			},
			"linux"  : {
				"command": "cd build && make -s",
                "problemMatcher": "$gcc",
			},
            "options": {
                "cwd": "${workspaceFolder}",
            },
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "dedicated",
                "clear": true,
				"showReuseMessage": false,
                "close": false,
			}
        },
        {
			"label": "Configure",
			"detail": "Generate build files.",
			"type": "shell",
			"windows": {
                "command": "call scripts/windows/configure.bat"
            },
			"linux"  : {
                "command": [
                    "cmake",
                    "-DCMAKE_C_COMPILER=gcc-14",
                    "-DCMAKE_CXX_COMPILER=g++-14",
                    "-DCMAKE_C_COMPILER_LAUNCHER=ccache",
                    "-DCMAKE_CXX_COMPILER_LAUNCHER=ccache",
                    "-DCMAKE_BUILD_TYPE=${input:build_type}",
                    "-S src",
                    "-B build"
                ]
            },
			"options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
            "problemMatcher": []
		},
		{
            "label": "Clean",
            "detail": "Remove the build files and directory.",
            "type": "shell",
            "linux": {
                "command": "sudo rm -rf ${workspaceFolder}/build "
            },
            "windows": {
                "command": "rd /S /Q build"
            },
            "problemMatcher": []
        },
        {
            "label": "Execute",
            "type": "shell",
            "windows": {
                "command": "install\\bin\\runes.exe"
            },
			"linux"  : {
                "command": "./build/bin/runes"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "build_type",
            "description": "Release of debug build?",
            "type": "pickString",
            "options": ["Debug", "Release"]
        }
    ]
}